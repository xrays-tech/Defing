+pub struct ElectionGuard {
+    raft: RaftHandle,
+    idle: Duration,
+    inner: Mutex<GuardState>,
+}
+
+struct GuardState {
+    deadline_ms: u64,
+    started: bool,
+}
+
+impl ElectionGuard {
+    pub fn new(raft: RaftHandle) -> Arc<Self> {
+        Arc::new(Self {
+            raft,
+            idle: Duration::from_secs(30),
+            inner: Mutex::new(GuardState {
+                deadline_ms: 0,
+                started: false,
+            }),
+        })
+    }
+
+    /// Suppress elections for `duration`; called for each snapshot chunk (30s) and by the
+    /// CLI on restart (4s startup grace). Deadlines are shared, so a snapshot chunk always
+    /// extends a startup grace instead of racing with a separate re-enable task.
+    pub fn arm_for(self: &Arc<Self>, duration: Duration) {
+        let mut st = self.inner.lock().expect("election guard lock");
+        self.raft.runtime_config().elect(false);
+        let deadline = now_ms() + duration.as_millis() as u64;
+        if deadline > st.deadline_ms {
+            st.deadline_ms = deadline;
+        }
+        if !st.started {
+            st.started = true;
+            let guard = Arc::clone(self);
+            drop(st);
+            tokio::spawn(async move {
+                loop {
+                    tokio::time::sleep(Duration::from_millis(200)).await;
+                    let mut st = guard.inner.lock().expect("election guard lock");
+                    if st.deadline_ms != 0 && now_ms() >= st.deadline_ms {
+                        guard.raft.runtime_config().elect(true);
+                        st.deadline_ms = 0;
+                    }
+                }
+            });
+        }
+    }
+
+    pub fn arm(self: &Arc<Self>) {
+        self.arm_for(self.idle);
+    }
+}
